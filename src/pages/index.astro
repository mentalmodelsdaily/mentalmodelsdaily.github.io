---
// Home is built in milestone 4; until then a plain page in the new layout.
import Base from "../layouts/Base.astro";
import { getSite } from "../lib/data";
const site = await getSite();
---
<Base description={site.hero_line}>
  <div class="wrap page-head measure">
    <h1>{site.name}</h1>
    <p>{site.hero_line}</p>
  </div>
</Base>
