---
// About and the six policy pages, from src/content/pages/*.md.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Prose from "../components/Prose.astro";
import { getChrome } from "../lib/data";
import { fillPlaceholders, placeholderKeys } from "../lib/placeholders";
import products from "../data/products.json";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { site, ui } = await getChrome();

const { html, unfilled } = fillPlaceholders(entry.rendered?.html ?? "", site, import.meta.env.DEV);
// A key named in the page but missing from the rendered HTML (e.g. inside a link) still counts.
for (const key of placeholderKeys(entry.body ?? "")) if (site[key as keyof typeof site] == null && !unfilled.includes(key)) unfilled.push(key);

// A page is a draft while it says so or while one of its placeholders has no value yet.
const draft = entry.data.draft || unfilled.length > 0;
if (draft && products.launch_mode === "live") {
  throw new Error(
    `src/content/pages/${entry.id}.md is still a draft (${entry.data.draft ? "draft: true" : "unfilled: " + unfilled.join(", ")}) while launch_mode is "live".`,
  );
}
---
<Base title={entry.data.title} description={entry.data.description}>
  <Prose title={entry.data.title} updated={entry.data.updated} draft={draft} ui={ui}>
    <Fragment set:html={html} />
  </Prose>
</Base>
