---
// A product image (cover, box, pair) as responsive AVIF/WebP.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
  vtName?: string;
  class?: string;
}
const { src, alt, sizes, eager = false, vtName, class: className } = Astro.props;
const widths = [320, 640, 960, 1280].filter((w) => w <= src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={["avif", "webp"]}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  class={className}
  style={vtName ? `view-transition-name: ${vtName}` : undefined}
/>
