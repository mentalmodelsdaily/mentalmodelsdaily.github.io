---
// A pencil drawing recoloured by CSS: the file is a mask over var(--draw) (SPEC.md §5, BRAND.md).
// It sits in a fixed 4:3 box so nothing shifts while it loads.
import type { ImageMetadata } from "astro";
import { drawingMasks } from "../lib/drawing";

interface Props {
  src: ImageMetadata;
  /** "Drawing: <model name>", or "" when the drawing is decorative. */
  alt: string;
  size?: "sm" | "md" | "lg";
  /** Part code: draws in that situation's colour. */
  part?: string;
  /** Plays the draw-in sweep (milestone 5). */
  draw?: boolean;
  vtName?: string;
  class?: string;
}
const { src, alt, size = "md", part, draw = false, vtName, class: className } = Astro.props;

// Browsers that cannot use AVIF in image-set() get the WebP (base.css chooses with @supports).
const { webp, avif } = await drawingMasks(src, size);
const style = [
  `--mask: url("${webp}")`,
  `--mask-set: image-set(url("${avif}") type("image/avif"), url("${webp}") type("image/webp"))`,
  vtName ? `view-transition-name: ${vtName}` : null,
].filter(Boolean).join("; ");
---
<div
  class:list={["drawing", `drawing--${size}`, { "drawing--part": part, "drawing--draw": draw }, className]}
  data-part={part}
  role={alt ? "img" : undefined}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : "true"}
  style={style}
></div>
