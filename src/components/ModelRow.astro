---
// A model in a list: small drawing, No., name, field chip, one-liner.
import type { ImageMetadata } from "astro";
import Drawing from "./Drawing.astro";
import FieldChip from "./FieldChip.astro";

interface Props {
  no: number;
  slug: string;
  name: string;
  oneLiner: string;
  part: string;
  field: { slug: string; label: string };
  drawing: ImageMetadata | null;
  vtName?: string;
  id?: string;
}
const { no, slug, name, oneLiner, part, field, drawing, vtName, id } = Astro.props;
---
<li class="model-row" data-part={part} data-field={field.slug} id={id}>
  {drawing ? <Drawing src={drawing} alt="" size="sm" part={part} vtName={vtName} class="model-row__drawing" /> : <span class="model-row__drawing" aria-hidden="true"></span>}
  <div class="model-row__text">
    <p class="model-row__meta label"><span>No. {no}</span> <FieldChip label={field.label} slug={field.slug} /></p>
    <h3 class="model-row__name"><a href={`/models/${slug}/`}>{name}</a></h3>
    <p class="model-row__line">{oneLiner}</p>
  </div>
</li>
