# Text files use LF line endings
*.astro text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.avif  binary
*.webp  binary
*.mp4   binary
*.webm  binary
*.woff2 binary
*.ico   binary
